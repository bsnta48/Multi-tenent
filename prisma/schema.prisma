// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Tenent {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  logo        String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  requests    Request[]
}

model User {
  id               String         @id @default(uuid())
  username         String         @unique
  email            String         @unique
  verified         Boolean        @default(false)
  password         String
  role             String         @default("member")
  verifyCode       String?
  verifyCodeExpiry DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  tenent           Tenent         @relation(fields: [tenentId], references: [id])
  tenentId         String
  tokenVersion     Int            @default(0)
  userProfile      UserProfile?
  requests         Request[]
  refreshTokens    RefreshToken[]
}

model UserProfile {
  id              String    @id @default(uuid())
  avatar          String?
  firstName       String?
  lastName        String?
  address         String?
  dob             DateTime?
  level           String?
  jobTitle        String?
  branch          String?
  department      String?
  subDepartment   String?
  unit            String?
  province        String?
  status          String?
  jobDescription  String?
  servicePeriod   String?
  joinDate        DateTime?
  phone           String?
  officialContact String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id])
  userId          String    @unique
}

model Invite {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  tenentId  String
  role      String
  token     String   @unique
  expireAt  DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  userId     String
  deviceName String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model Request {
  id          String   @id @default(uuid())
  type        String
  event       String?
  description String?
  status      String   @default("pending")
  replyText   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  tenent      Tenent   @relation(fields: [tenentId], references: [id])
  tenentId    String
}
